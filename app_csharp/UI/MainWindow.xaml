<Window x:Class="SoundPulse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SoundPulse AI — Музыкальный плеер и классификатор"
        Icon="pack://application:,,,/app.ico"
        Width="1260"
        Height="790"
        MinWidth="1020"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{StaticResource BgCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="94" />
        </Grid.RowDefinitions>

        <!-- ==================== TITLEBAR ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentPrimaryBrush}">
                        <Path Data="M 5,12 V 6 M 9,14 V 3 M 13,11 V 5 M 17,12 V 7"
                              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SoundPulse" FontSize="13.5" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Background="#20253A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" />
                    </Border>
                </StackPanel>

                <!-- Model Status Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="ModelStatusDot" Width="7" Height="7" Fill="#FBBF24" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModelStatusText"
                               Text="Загрузка MusicAudioNet (ONNX)…"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Chrome Buttons (Crisp Vector Paths) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click" ToolTip="Развернуть">
                        <Path x:Name="MaximizeIconPath" Data="M 1,1 H 9 V 9 H 1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButtonStyle}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT SIDEBAR ========== -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Import & Download Actions -->
                    <StackPanel Grid.Row="0" Margin="14,12,14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+ Файлы" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="10,7" Click="AddFiles_Click" />
                            <Button Grid.Column="2" Content="+ Папка" Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,7" Click="AddFolder_Click" />
                        </Grid>

                        <Button x:Name="DownloadTabBtn" Style="{StaticResource SubtleButtonStyle}"
                                Padding="10,7" Margin="0,7,0,0" Click="OpenDownloadView_Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 7,1 V 10 M 3.5,6.5 L 7,10.5 L 10.5,6.5 M 2,13 H 12"
                                          Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Скачать / Автоимпорт" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Ellipse x:Name="SidebarWatchDot" Width="6" Height="6" Fill="#10B981"
                                             Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                             ToolTip="Папка автоимпорта активна" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Categories List (All 3 Vibes + 2x5 Genre Grid fit without scrolling!) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,2">
                        <StackPanel>
                            <!-- All Tracks -->
                            <TextBlock Text="БИБЛИОТЕКА" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="8,4,8,3" />
                            <ItemsControl x:Name="LibraryFiltersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="FilterItem_Click" Tag="{Binding}" Cursor="Hand" Margin="0,1">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBd" CornerRadius="7" Padding="10,6" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="0" Data="M 4,13 V 4 L 12,2.5 V 11.5 M 4,13 A 2,1.6 0 1 1 0.5,13 A 2,1.6 0 1 1 4,13 M 12,11.5 A 2,1.6 0 1 1 8.5,11.5 A 2,1.6 0 1 1 12,11.5"
                                                                  Stroke="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                                  StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" FontWeight="Medium"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="2" Background="#1D2232" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#20273B" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#1B2133" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Vibes -->
                            <TextBlock Text="ВАЙБ / НАСТРОЕНИЕ" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="8,8,8,3" />
                            <ItemsControl x:Name="VibeFiltersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="FilterItem_Click" Tag="{Binding}" Cursor="Hand" Margin="0,1">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBd" CornerRadius="7" Padding="10,5.5" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                                     Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="Medium"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="2" Background="#1D2232" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#20273B" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#1B2133" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Genres (2-column Compact Grid — adapts dynamically to 10 or 12 genres!) -->
                            <TextBlock x:Name="GenresHeaderText" Text="ЖАНРЫ (10 КЛАССОВ)" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="8,8,8,4" />
                            <ItemsControl x:Name="GenreFiltersList" Margin="2,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="FilterItem_Click" Tag="{Binding}" Cursor="Hand" Margin="2">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ItemBd" CornerRadius="7" Padding="8,5"
                                                            Background="#151925" BorderBrush="#212739" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Grid.Column="0" Width="6" Height="6"
                                                                     Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#202840" />
                                                            <Setter TargetName="ItemBd" Property="BorderBrush" Value="#4F46E5" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#1B2235" />
                                                            <Setter TargetName="ItemBd" Property="BorderBrush" Value="#313B57" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer Actions -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <Button Content="Разложить по папкам…" Style="{StaticResource SubtleButtonStyle}"
                                    Click="ExportFolders_Click" ToolTip="Скопировать проанализированные треки по папкам Вайб / Жанр" />
                            <Button Content="Очистить библиотеку" Style="{StaticResource IconButtonStyle}"
                                    Width="Auto" Height="26" FontSize="11.5" Margin="0,5,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Click="ClearLibrary_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========== CENTER WORKSPACE (Library View + Download Hub) ========== -->
            <Grid Grid.Column="1" Background="{StaticResource BgCanvasBrush}">

                <!-- ===== LIBRARY VIEW ===== -->
                <Grid x:Name="LibraryViewGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <!-- Active Filter Header + Search -->
                <Grid Grid.Row="0" Margin="22,16,22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ActiveCategoryDot" Width="10" Height="10" Fill="{StaticResource AccentPrimaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="ActiveCategoryTitle" Text="Все треки" FontSize="21" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ActiveCategorySubtitle" Text="Добавьте аудиофайлы или перетащите папку в окно"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="220" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск трека, артиста, жанра…"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="PlayFiltered_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1,0 L 9,5 L 1,10 Z" Fill="White" Width="8" Height="9" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Играть" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Background AI Queue Progress Banner -->
                <Border x:Name="AnalysisBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="#171C2B" BorderBrush="#283047" BorderThickness="1"
                        CornerRadius="8" Margin="22,0,22,10" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AnalysisProgressText" Text="AI-классификация треков…"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ProgressBar x:Name="AnalysisProgressBar" Grid.Column="1" Style="{StaticResource ScoreBarStyle}"
                                     Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Column Headers -->
                <Border Grid.Row="2" Margin="22,0,22,4" Padding="12,6"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="106" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="ТРЕК / ИСПОЛНИТЕЛЬ" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="ЖАНР (AI)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="3" Text="ВАЙБ" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="4" Text="ВРЕМЯ" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Track List + Empty Drop Zone -->
                <Grid Grid.Row="3" Margin="14,0,14,8">
                    <ListBox x:Name="TrackListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="TrackListBox_SelectionChanged"
                             MouseDoubleClick="TrackListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="12,9"
                                                    Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#171C29" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1D2437" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#2F3A56" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1C2238" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#4F46E5" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Воспроизвести" Click="ContextPlay_Click" />
                                <MenuItem Header="Переанализировать моделью" Click="ContextReanalyze_Click" />
                                <MenuItem Header="Показать файл в проводнике" Click="ContextShowInExplorer_Click" />
                                <Separator />
                                <MenuItem Header="Удалить из библиотеки" Click="ContextRemove_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="136" />
                                        <ColumnDefinition Width="106" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Play State Indicator (Vector) -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Path Data="M 1,0 L 9,5 L 1,10 Z" Fill="{StaticResource AccentHoverBrush}"
                                              Width="9" Height="10" Stretch="Uniform" HorizontalAlignment="Left"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource TextMutedBrush}"
                                                 HorizontalAlignment="Left" Margin="2,0,0,0"
                                                 Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}" />
                                    </Grid>

                                    <!-- Title & Artist -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Genre Pill -->
                                    <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            CornerRadius="6" Padding="8,3"
                                            Background="{Binding GenreColorHex, Converter={StaticResource HexToSoftBrush}}">
                                        <TextBlock Text="{Binding GenreBadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding GenreColorHex, Converter={StaticResource HexToBrush}}" />
                                    </Border>

                                    <!-- Vibe Pill (Clean Colored Dot + Label) -->
                                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            CornerRadius="6" Padding="8,3"
                                            Background="{Binding VibeColorHex, Converter={StaticResource HexToSoftBrush}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Fill="{Binding VibeColorHex, Converter={StaticResource HexToBrush}}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding VibeBadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding VibeColorHex, Converter={StaticResource HexToBrush}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Drop Zone -->
                    <Border x:Name="EmptyStatePanel"
                            Background="#10131C"
                            BorderBrush="#252C40"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Margin="16,20,16,20"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <Border Width="58" Height="58" CornerRadius="16" Background="#1A2033" HorizontalAlignment="Center">
                                <Path Data="M 4,14 V 7 M 9,16 V 3 M 14,13 V 5 M 19,14 V 8"
                                      Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="24" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyStateTitle" Text="Перетащите музыку сюда" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock x:Name="EmptyStateDesc"
                                       Text="Поддерживаются MP3, WAV, FLAC, OGG, M4A, AAC, WMA. Модель MusicAudioNet автоматически определит жанр и вайб каждого трека."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Выбрать файлы" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddFiles_Click" Margin="0,0,8,0" />
                                <Button Content="Выбрать папку" Style="{StaticResource SubtleButtonStyle}"
                                        Click="AddFolder_Click" Margin="0,0,8,0" />
                                <Button Content="Скачать музыку" Style="{StaticResource SubtleButtonStyle}"
                                        Click="OpenDownloadView_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>

                <!-- ===== DOWNLOAD & WATCH FOLDER HUB ===== -->
                <Grid x:Name="DownloadViewGrid" Visibility="Collapsed" Margin="22,16,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Скачать музыку" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Ссылки YouTube / SoundCloud / плейлисты, поиск Audius или прямые URL (.mp3, .m4a, .flac)"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="← К библиотеке" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" Click="BackToLibrary_Click" />
                    </Grid>

                    <!-- Search / URL Input Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="DownloadQueryBox" Style="{StaticResource SearchBoxStyle}"
                                     Padding="12,9" FontSize="13"
                                     TextChanged="DownloadQueryBox_TextChanged"
                                     KeyDown="DownloadQueryBox_KeyDown" />
                            <TextBlock x:Name="DownloadQueryPlaceholder"
                                       Text="Название трека / исполнителя или ссылка (.mp3, .m4a, YouTube, SoundCloud)…"
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </Grid>

                        <Button x:Name="DownloadActionBtn" Grid.Column="2" Content="Найти / Скачать"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="16,9"
                                Click="DownloadSearchOrUrl_Click" />

                        <Button x:Name="DownloadAllPlaylistBtn" Grid.Column="3" Content="Скачать все"
                                Style="{StaticResource SubtleButtonStyle}" Padding="12,9" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="DownloadAllResults_Click" />
                    </Grid>

                    <!-- Status / Progress Strip -->
                    <Border x:Name="DownloadStatusBanner" Grid.Row="2" Visibility="Collapsed"
                            Background="#171C2B" BorderBrush="#283047" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DownloadStatusText" Text="Поиск…" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,12,0" />
                            <ProgressBar x:Name="DownloadStatusBar" Grid.Column="1" Style="{StaticResource ScoreBarStyle}"
                                         Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Search Results List + Hint Empty State -->
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <ListBox x:Name="SearchResultsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ResBd" Background="#131722" BorderBrush="#212739"
                                                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ResBd" Property="Background" Value="#181E2D" />
                                                        <Setter TargetName="ResBd" Property="BorderBrush" Value="#313B57" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="116" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Width="50" Height="36" CornerRadius="6"
                                                Background="#1D2336" ClipToBounds="True" HorizontalAlignment="Left">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title & Artist -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                                        <!-- Download Button -->
                                        <Button Grid.Column="3"
                                                Content="{Binding ButtonText}"
                                                IsEnabled="{Binding CanDownload}"
                                                Tag="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="10,6" FontSize="12"
                                                Click="DownloadResultItem_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty Hint Card -->
                        <Border x:Name="DownloadEmptyHint"
                                Background="#10131C" BorderBrush="#232A3D" BorderThickness="1"
                                CornerRadius="12" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                                <TextBlock Text="Как добавить треки" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="• Вставьте ссылку YouTube / SoundCloud / Bandcamp / плейлист — движок yt-dlp установится сам при первом скачивании, а трек сохранится с обложкой и тегами.&#x0a;• Введите название трека или исполнителя — поиск по открытому каталогу Audius (MP3).&#x0a;• Вставьте прямую ссылку (.mp3, .m4a, .flac, .ogg, .wav) — скачается сразу.&#x0a;• Или включите «Папку-приёмник» ниже — плеер сам подхватит файлы из Загрузок / Telegram."
                                           FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Storage & Watch Folder Settings Card -->
                    <Border Grid.Row="4" Background="#121621" BorderBrush="#242B3E" BorderThickness="1"
                            CornerRadius="10" Padding="12,9">
                        <StackPanel>
                            <!-- Download Folder Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="ПАПКА ХРАНЕНИЯ СКАЧАННЫХ ТРЕКОВ" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="DownloadFolderPathText" Text="C:\Users\...\Music\SoundPulse"
                                               FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Изменить…" Style="{StaticResource SubtleButtonStyle}"
                                            Padding="9,4" FontSize="11" Margin="0,0,6,0"
                                            Click="ChangeDownloadFolder_Click" />
                                    <Button Content="Открыть" Style="{StaticResource SubtleButtonStyle}"
                                            Padding="9,4" FontSize="11"
                                            Click="OpenDownloadFolder_Click" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="AutoSortCheckBox" Style="{StaticResource DarkCheckBoxStyle}"
                                      FontSize="11.5"
                                      Content="Автосортировка: раскладывать скачанные по Вайб \ Жанр"
                                      Margin="0,7,0,7"
                                      Checked="AutoSortCheckBox_Changed" Unchecked="AutoSortCheckBox_Changed" />

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,7" />

                            <!-- Watch Folder Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="WatchFolderCheckBox" Style="{StaticResource DarkCheckBoxStyle}"
                                                  FontSize="11.5"
                                                  Content="Папка-приёмник (автоимпорт новых файлов)"
                                                  Checked="WatchFolderCheckBox_Changed" Unchecked="WatchFolderCheckBox_Changed" />
                                        <TextBlock x:Name="WatchStatusBadge" Text="" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="#10B981" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="WatchFolderPathText"
                                               Text="Не выбрана (например, Загрузки или Telegram Desktop)"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="43,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Выбрать папку…" Style="{StaticResource SubtleButtonStyle}"
                                        Padding="9,4" FontSize="11" VerticalAlignment="Center"
                                        Click="ChooseWatchFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== RIGHT AI INSPECTOR PANEL (Compact, Zero-Scroll Layout) ========== -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel x:Name="InspectorRoot">
                        <!-- Compact Artwork + Real 12-Band FFT Equalizer Card -->
                        <Border x:Name="ArtworkCard"
                                Height="114"
                                CornerRadius="12"
                                Background="#191F30"
                                BorderBrush="#283047"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="ArtworkGradientBg">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#232B45" Offset="0" />
                                            <GradientStop Color="#121622" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="ArtworkMonogram" Text="♪" FontSize="44" FontWeight="Bold"
                                           Foreground="#2BFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" />

                                <Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />

                                <!-- Bottom Scrim + Live 12-Band Frequency FFT Spectrum -->
                                <Border VerticalAlignment="Bottom" Height="64">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#000B0D13" Offset="0" />
                                            <GradientStop Color="#E60B0D13" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <UniformGrid x:Name="VisualizerGrid" Rows="1" Columns="12"
                                                 VerticalAlignment="Bottom" Height="44" Margin="18,0,18,10" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Track Meta -->
                        <TextBlock x:Name="InspectorTitle" Text="Трек не выбран" FontSize="15.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="0,12,0,0" />
                        <TextBlock x:Name="InspectorArtist" Text="Выберите трек для просмотра AI-анализа"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock x:Name="InspectorMetaLine" Text="" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />

                        <!-- Dominant AI Vibe Banner -->
                        <Border x:Name="InspectorVibeCard" Visibility="Collapsed"
                                CornerRadius="10" Padding="12,9" Margin="0,12,0,0"
                                Background="#171D2E" BorderBrush="#29334D" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="КАТЕГОРИЯ / ВАЙБ" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse x:Name="InspectorVibeDot" Width="8" Height="8" Fill="#10B981"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="InspectorVibeLabel" Text="Драйв / Энергия"
                                                   FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="InspectorVibePct" Grid.Column="1" Text="94%"
                                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Vibes Breakdown -->
                        <StackPanel x:Name="InspectorVibesSection" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="InspectorVibesHeader" Text="НАСТРОЕНИЕ (5 КЛАССОВ)" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" />
                            <ItemsControl x:Name="InspectorVibesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource ScoreBarStyle}" Height="4.5"
                                                         Value="{Binding PercentValue, Mode=OneWay}"
                                                         Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Top-5 Genres Breakdown (All 5 fit without scrolling!) -->
                        <StackPanel x:Name="InspectorGenresSection" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="ТОП-5 ЖАНРОВ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" />
                            <ItemsControl x:Name="InspectorGenresList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource ScoreBarStyle}" Height="4.5"
                                                         Value="{Binding PercentValue, Mode=OneWay}"
                                                         Foreground="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Error Notice -->
                        <Border x:Name="InspectorErrorBox" Visibility="Collapsed"
                                Background="#2B141C" BorderBrush="#F43F5E" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <TextBlock x:Name="InspectorErrorText" FontSize="11.5" Foreground="#FDA4AF" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM PLAYER BAR ==================== -->
        <Border Grid.Row="2"
                Background="#10131C"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- Now Playing Mini Info -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MiniCoverBorder" Grid.Column="0" Width="46" Height="46" CornerRadius="9"
                            Background="#1D2336" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="MiniCoverMonogram" Text="♪" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="MiniCoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock x:Name="NowPlayingTitle" Text="Нет активного трека" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowPlayingSubtitle" Text="Двойной клик по треку для запуска" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Transport Controls + Seek Bar (Clean Vector SVG Icons!) -->
                <Grid Grid.Column="1" MaxWidth="560" Margin="16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Shuffle -->
                        <Button x:Name="ShuffleBtn" Style="{StaticResource IconButtonStyle}"
                                Click="Shuffle_Click" ToolTip="Перемешать" Margin="6,0">
                            <Path Data="M 1,4 H 4.5 L 11.5,12 H 15 M 12.5,9.5 L 15,12 L 12.5,14.5 M 1,12 H 4.5 L 6.8,9.4 M 9.2,6.6 L 11.5,4 H 15 M 12.5,1.5 L 15,4 L 12.5,6.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" />
                        </Button>

                        <!-- Previous -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="Prev_Click" ToolTip="Предыдущий трек" Margin="6,0">
                            <Path Data="M 2,2.5 H 4.2 V 13.5 H 2 Z M 13.5,2.5 L 5,8 L 13.5,13.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Play / Pause Circle (High-Contrast Dark Vector on White Circle!) -->
                        <Button x:Name="PlayPauseBtn"
                                Width="40" Height="40"
                                Style="{StaticResource PlayCircleButtonStyle}"
                                Click="PlayPause_Click" ToolTip="Воспроизвести / Пауза (Space)" Margin="12,0">
                            <Grid Width="15" Height="15">
                                <Path x:Name="PlayIconPath"
                                      Data="M 3,1.5 L 14,7.5 L 3,13.5 Z"
                                      Fill="#0B0D13"
                                      Stretch="Uniform"
                                      Margin="1,0,0,0"
                                      Visibility="Visible" />
                                <Path x:Name="PauseIconPath"
                                      Data="M 2,1.5 H 5.6 V 13.5 H 2 Z M 9.4,1.5 H 13 V 13.5 H 9.4 Z"
                                      Fill="#0B0D13"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <!-- Next -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="Next_Click" ToolTip="Следующий трек" Margin="6,0">
                            <Path Data="M 2.5,2.5 L 11,8 L 2.5,13.5 Z M 11.8,2.5 H 14 V 13.5 H 11.8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Repeat -->
                        <Button x:Name="RepeatBtn" Style="{StaticResource IconButtonStyle}"
                                Click="Repeat_Click" ToolTip="Повтор трека" Margin="6,0">
                            <Path Data="M 13,2 L 15.5,4.5 L 13,7 M 2,8 V 6.5 A 2,2 0 0 1 4,4.5 H 15 M 3,14 L 0.5,11.5 L 3,9 M 14,8 V 9.5 A 2,2 0 0 1 12,11.5 H 1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeCurrentText" Grid.Column="0" Text="00:00" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SleekSliderStyle}"
                                IsMoveToPointEnabled="False"
                                Minimum="0" Maximum="100" Value="0"
                                PreviewMouseMove="SeekSlider_PreviewMouseMove"
                                LostMouseCapture="SeekSlider_LostMouseCapture"
                                Margin="8,0" />
                        <TextBlock x:Name="TimeTotalText" Grid.Column="2" Text="00:00" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Volume Controls (Crisp Vector Speaker) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MuteBtn" Style="{StaticResource IconButtonStyle}"
                            Click="Mute_Click" ToolTip="Выключить / Включить звук">
                        <Grid Width="16" Height="16">
                            <Path x:Name="VolOnPath"
                                  Data="M 1,5.5 H 4.5 L 8.5,2 V 14 L 4.5,10.5 H 1 Z M 11,5 A 4,4 0 0 1 11,11 M 13,3 A 7,7 0 0 1 13,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Visibility="Visible" />
                            <Path x:Name="VolMutePath"
                                  Data="M 1,5.5 H 4.5 L 8.5,2 V 14 L 4.5,10.5 H 1 Z M 11.5,5.5 L 15.5,10.5 M 15.5,5.5 L 11.5,10.5"
                                  Stroke="#F43F5E"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="114" Style="{StaticResource SleekSliderStyle}"
                            Minimum="0" Maximum="100" Value="80"
                            ValueChanged="VolumeSlider_ValueChanged" Margin="6,0,8,0" />
                    <TextBlock x:Name="VolumePctText" Text="80%" Width="34" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== DRAG & DROP OVERLAY ==================== -->
        <Border x:Name="DragOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                Background="#CC0B0D13" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource AccentHoverBrush}" BorderThickness="2" CornerRadius="18"
                    Margin="28" Background="#1A6366F1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="↓" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Отпустите файлы или папку для добавления и AI-анализа"
                               FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
